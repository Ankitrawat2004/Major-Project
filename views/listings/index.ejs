<% layout("/layouts/boilerplate") %>

<%
  const byLocation = (places) => allListings.filter((listing) => {
    const location = (listing.location || "").toLowerCase();
    return places.some((place) => location.includes(place));
  });

  const noidaListings = byLocation(["noida"]);
  const gurgaonListings = byLocation(["gurgaon", "gurugram"]);
  const delhiNcrListings = byLocation(["delhi", "ghaziabad", "faridabad"]);
  const usedIds = new Set([
    ...noidaListings,
    ...gurgaonListings,
    ...delhiNcrListings
  ].map((listing) => String(listing._id)));
  const otherFavourites = allListings.filter((listing) => !usedIds.has(String(listing._id)));

  const homeSections = [
    {
      title: "Popular homes in Noida",
      listings: noidaListings.length ? noidaListings : allListings.slice(0, 6)
    },
    {
      title: "Available in Gurgaon District this weekend",
      listings: gurgaonListings.length ? gurgaonListings : allListings.slice(6, 12)
    },
    {
      title: "Stay in Delhi NCR",
      listings: delhiNcrListings.length ? delhiNcrListings : allListings.slice(12, 18)
    },
    {
      title: "Guest favourites in India",
      listings: otherFavourites.slice(0, 8)
    }
  ].filter(section => section.listings.length);
%>

<main class="airbnb-home">
  <% homeSections.forEach((section, sectionIndex) => { %>
    <section class="home-section" aria-labelledby="section-title-<%= sectionIndex %>">
      <div class="section-heading">
        <h2 id="section-title-<%= sectionIndex %>">
          <%= section.title %>
          <span class="heading-arrow" aria-hidden="true">›</span>
        </h2>
        <div class="section-controls" aria-label="<%= section.title %> carousel controls">
          <button type="button" class="scroll-button scroll-back" aria-label="Scroll back" disabled>
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <button type="button" class="scroll-button scroll-forward" aria-label="Scroll forward">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>
      </div>

      <div class="listing-rail">
        <% section.listings.forEach((listing, listingIndex) => { %>
          <article class="home-listing-card">
            <a href="/listings/<%= listing._id %>" class="home-listing-link" aria-label="View <%= listing.title %>">
              <div class="listing-photo-wrap">
                <img
                  src="<%= listing.image.url %>"
                  class="listing-photo"
                  alt="<%= listing.title %>"
                  loading="<%= sectionIndex === 0 && listingIndex < 4 ? 'eager' : 'lazy' %>"
                />
                <span class="guest-badge">Guest favourite</span>
                <button type="button" class="heart-button" aria-label="Add <%= listing.title %> to favourites">
                  <i class="fa-regular fa-heart"></i>
                </button>
              </div>
              <div class="listing-copy">
                <h3><%= listing.title %></h3>
                <p class="listing-location"><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></p>
                <p class="listing-meta">
                  <span>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> for 2 nights</span>
                  <span aria-hidden="true"> · </span>
                  <span><i class="fa-solid fa-star"></i> <%= (4.72 + ((sectionIndex + listingIndex) % 6) * 0.05).toFixed(2) %></span>
                </p>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>
</main>

<div class="fee-toast" role="status">
  <span class="fee-tag"><i class="fa-solid fa-tag"></i></span>
  <span>Prices include all fees</span>
</div>

<script>
  document.querySelectorAll(".home-section").forEach((section) => {
    const rail = section.querySelector(".listing-rail");
    const back = section.querySelector(".scroll-back");
    const forward = section.querySelector(".scroll-forward");

    const updateControls = () => {
      back.disabled = rail.scrollLeft < 10;
      forward.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 10;
    };

    back.addEventListener("click", () => {
      rail.scrollBy({ left: -rail.clientWidth * 0.8, behavior: "smooth" });
    });

    forward.addEventListener("click", () => {
      rail.scrollBy({ left: rail.clientWidth * 0.8, behavior: "smooth" });
    });

    rail.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });

  document.querySelectorAll(".heart-button").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const icon = button.querySelector("i");
      const selected = icon.classList.toggle("fa-solid");
      icon.classList.toggle("fa-regular", !selected);
      button.classList.toggle("is-saved", selected);
      button.setAttribute("aria-label", selected ? "Remove from favourites" : "Add to favourites");
    });
  });
</script>
